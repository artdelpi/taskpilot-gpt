<div class="task-fields border rounded p-3 mb-3">
  <div class="row g-3">
    <div class="col-md-6">
      <%= f.label :title, class: "form-label" %>
      <%= f.text_field :title, class: "form-control", placeholder: "Task title" %>
    </div>

    <div class="col-md-6">
      <%= f.label :due_date, class: "form-label" %>
      <%= f.date_field :due_date, class: "form-control" %>
    </div>

    <div class="col-md-8">
      <%= f.label :description, class: "form-label" %>
      <%= f.text_area :description, rows: 2, class: "form-control" %>
    </div>

    <div class="col-md-2">
      <%= f.label :status, class: "form-label" %>
      <%= f.select :status,
            options_for_select([["Pending","pending"],["In progress","in_progress"],["Completed","completed"]], f.object.status),
            {}, class: "form-select" %>
    </div>

    <div class="col-md-2">
      <%= f.label :priority, class: "form-label" %>
      <%= f.select :priority,
            options_for_select([["Low","low"],["Medium","medium"],["High","high"]], f.object.priority),
            {}, class: "form-select" %>
    </div>
  </div>

  <!-- Para suportar remoção de registros já persistidos via accepts_nested_attributes_for -->
  <%= f.hidden_field :_destroy, class: "task-destroy-flag", value: "0" %>
  <!-- Opcional: manter o :id explícito ajuda na remoção de existentes -->
  <%= f.hidden_field :id if f.object&.id.present? %>

  <div class="d-flex justify-content-end mt-2">
    <button type="button"
            class="btn btn-outline-danger btn-sm"
            data-role="remove-task"
            data-action="click->tasks-form#remove">
      <i class="bi bi-trash"></i> Remove
    </button>
  </div>
</div>
